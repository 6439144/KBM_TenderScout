# KBM Tender Monitoring Agent - Environment Template
# Copy this file to .env for local development ONLY.
# NEVER commit the real .env file or real credentials.
# In production, use the designated secrets vault.

# CAPT (Central Agency for Public Tenders - capt.gov.kw)
CAPT_USERNAME=
CAPT_PASSWORD=

# Kuwait Al-Yawm (Official Gazette - kuwaitalyawm.media.gov.kw)
ALYAWM_USERNAME=
ALYAWM_PASSWORD=

# Optional LLM API Key (for client/sector classification fallback)
# GEMINI_API_KEY=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=

# Optional Notifications / Delivery (e.g. SMTP, Teams Webhook)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# TEAMS_WEBHOOK_URL=
